[Unit]
Description=PS4 User Guide DNS on the home LAN
After=network-online.target
Wants=network-online.target

[Service]
User=nichlas
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/etc/ps4-guide-dns.conf --pid-file=
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
